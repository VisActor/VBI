{
  "name": "@visactor/vbi-desktop",
  "version": "1.0.1",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "wait-on http://localhost:3000 && electron .",
    "build:exe": "pnpm --filter website run build && electron-builder --win"
  },
  "build": {
    "appId": "com.visactor.vbidesktop",
    "productName": "VBI Desktop",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "files": [
      "main.js",
      "package.json",
      {
        "from": "../website/doc_build",
        "to": "dist/VBI",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "electron": "41.1.0",
    "electron-builder": "26.8.1",
    "wait-on": "9.0.4"
  },
  "dependencies": {
    "electron-serve": "3.0.1",
    "express": "5.2.1"
  }
}
