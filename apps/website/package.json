    "yjs": "13.6.28",
    "zustand": "5.0.6",
    "dashboard": "workspace:*"
  },
  "devDependencies": {
    "@rspress/plugin-playground": "2.0.22",
    "@rspress/plugin-preview": "2.0.22",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
