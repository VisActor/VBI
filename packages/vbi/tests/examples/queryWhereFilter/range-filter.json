{
  "name": "range-filter",
  "builder": "query",
  "description": "先保留单笔销售额在 100 到 1000 之间的记录，再按品类求和。",
  "tags": ["query", "whereFilter"],
  "priority": 2,
  "dsl": {
    "dimensions": [
      {
        "id": "productType",
        "field": "product_type",
        "alias": "品类"
      }
    ],
    "measures": [
      {
        "id": "sales",
        "field": "sales",
        "alias": "销售额",
        "aggregate": {
          "func": "sum"
        }
      }
    ],
    "limit": 3
  },
  "code": "const applyBuilder = (builder: VBIQueryBuilder) => {\n  builder.whereFilter.add('sales', node => node.setOperator('between').setValue([100, 1000]))\n}"
}
