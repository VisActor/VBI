{
  "name": "bar-by-province-with-filter",
  "description": "柱状图 - 按省份销售额（带过滤条件）",
  "schema": [
    {
      "name": "province",
      "type": "string"
    },
    {
      "name": "sales",
      "type": "number"
    }
  ],
  "dsl": {
    "chartType": "bar",
    "dimensions": [
      {
        "field": "province",
        "alias": "省份"
      }
    ],
    "measures": [
      {
        "field": "sales",
        "alias": "销售额",
        "encoding": "xAxis",
        "aggregate": {
          "func": "sum"
        }
      }
    ],
    "whereFilters": {
      "id": "00000000-0000-0000-0000-000000000001",
      "op": "AND",
      "conditions": [
        { "id": "00000000-0000-0000-0000-000000000002", "field": "product_type", "op": "eq", "value": "办公用品" }
      ]
    },
    "limit": 20
  },
  "code": "const applyBuilder = (builder: VBIBuilder) => { builder.whereFilters.add('product_type', node => { node.setOperator('eq').setValue('办公用品'); }); }"
}
