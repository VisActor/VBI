{
  "name": "clear-where-filters",
  "description": "清空所有Where过滤条件",
  "schema": [
    {
      "name": "province",
      "type": "string"
    },
    {
      "name": "product_type",
      "type": "string"
    },
    {
      "name": "sales",
      "type": "number"
    }
  ],
  "dsl": {
    "chartType": "bar",
    "dimensions": [
      {
        "field": "province",
        "alias": "省份"
      }
    ],
    "measures": [
      {
        "field": "sales",
        "alias": "销售额",
        "encoding": "yAxis",
        "aggregate": {
          "func": "sum"
        }
      }
    ],
    "whereFilters": {
      "id": "00000000-0000-0000-0000-000000000001",
      "op": "AND",
      "conditions": [
        { "id": "00000000-0000-0000-0000-000000000002", "field": "product_type", "op": "eq", "value": "办公用品" },
        { "id": "00000000-0000-0000-0000-000000000003", "field": "province", "op": "eq", "value": "浙江" }
      ]
    },
    "limit": 20
  },
  "code": "const applyBuilder = (builder: VBIBuilder) => { builder.whereFilters.clear(); }"
}
