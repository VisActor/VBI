{
  "name": "remove-dimension",
  "builder": "query",
  "description": "移除品类维度，将区域与品类明细汇总为区域销售额。",
  "tags": ["query", "dimensions"],
  "priority": 3,
  "dsl": {
    "dimensions": [
      {
        "id": "region",
        "field": "area",
        "alias": "区域"
      },
      {
        "id": "productType",
        "field": "product_type",
        "alias": "品类"
      }
    ],
    "measures": [
      {
        "id": "sales",
        "field": "sales",
        "alias": "销售额",
        "aggregate": {
          "func": "sum"
        }
      }
    ],
    "limit": 5
  },
  "code": "const applyBuilder = (builder: VBIQueryBuilder) => {\n  builder.dimensions.remove('productType')\n}"
}
