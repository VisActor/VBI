{
  "builder": "query",
  "name": "nested-functions",
  "description": "通过参数和嵌套数值函数计算调整后的利润率；按最终结果排序并限制返回行数。",
  "tags": ["query", "expression", "null"],
  "priority": 4,
  "dsl": {
    "dimensions": [
      {
        "id": "region",
        "field": "area",
        "alias": "区域"
      }
    ],
    "measures": [
      {
        "id": "sales",
        "field": "sales",
        "alias": "销售额",
        "aggregate": {
          "func": "sum"
        }
      },
      {
        "id": "profit",
        "field": "profit",
        "alias": "利润",
        "aggregate": {
          "func": "sum"
        }
      }
    ],
    "calculations": [
      {
        "id": "adjustedMargin",
        "alias": "调整利润率",
        "expr": "ABS(COALESCE(profit,0)-?)/NULLIF(sales,0)",
        "parameters": [1000],
        "sort": {
          "order": "desc"
        }
      }
    ],
    "limit": 3
  },
  "code": "const applyBuilder = async (builder: VBIQueryBuilder) => {\n  return await builder.query()\n}"
}
