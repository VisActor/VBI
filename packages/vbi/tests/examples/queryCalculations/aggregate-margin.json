{
  "builder": "query",
  "name": "aggregate-margin",
  "description": "按区域汇总销售额和利润，计算整体利润率并按利润率取前三名；配置和参数可保存、协同和撤销。",
  "tags": ["query", "expression", "ratio"],
  "priority": 3,
  "dsl": {
    "dimensions": [
      {
        "id": "region",
        "field": "area",
        "alias": "区域"
      }
    ],
    "measures": [
      {
        "id": "sales",
        "field": "sales",
        "alias": "销售额",
        "aggregate": {
          "func": "sum"
        }
      },
      {
        "id": "profit",
        "field": "profit",
        "alias": "利润",
        "aggregate": {
          "func": "sum"
        }
      }
    ],
    "calculations": [
      {
        "id": "margin",
        "alias": "利润率",
        "expr": "profit / NULLIF(sales, 0)",
        "sort": {
          "order": "desc"
        }
      }
    ],
    "limit": 3
  },
  "code": "const applyBuilder = async (builder: VBIQueryBuilder) => {\n  return await builder.query()\n}"
}
