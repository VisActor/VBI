{
  "datasetId": "subquery-empty-result",
  "description": "内层没有符合 HAVING 条件的分组时，外层 COUNT 返回 0，SUM 和 MAX 返回 NULL。",
  "vquery": {
    "from": {
      "select": [
        "region",
        "store",
        {
          "field": "sales",
          "alias": "storeTotal",
          "aggr": {
            "func": "sum"
          }
        }
      ],
      "groupBy": ["region", "store"],
      "having": {
        "op": "and",
        "conditions": [
          {
            "field": "sales",
            "aggr": {
              "func": "sum"
            },
            "op": ">",
            "value": 100
          }
        ]
      }
    },
    "select": [
      {
        "field": "*",
        "alias": "rows",
        "aggr": {
          "func": "count"
        }
      },
      {
        "field": "storeTotal",
        "alias": "total",
        "aggr": {
          "func": "sum"
        }
      },
      {
        "field": "storeTotal",
        "alias": "maximum",
        "aggr": {
          "func": "max"
        }
      }
    ]
  },
  "dataset": [
    { "region": "East", "store": "A", "sales": 10 },
    { "region": "East", "store": "A", "sales": 20 },
    { "region": "East", "store": "B", "sales": 40 },
    { "region": "West", "store": "C", "sales": 15 },
    { "region": "West", "store": "C", "sales": 5 },
    { "region": "West", "store": "D", "sales": 60 }
  ],
  "schema": [
    {
      "name": "region",
      "type": "string"
    },
    {
      "name": "store",
      "type": "string"
    },
    {
      "name": "sales",
      "type": "number"
    }
  ]
}
