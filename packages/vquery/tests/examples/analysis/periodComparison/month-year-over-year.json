{
  "datasetId": "analysis-month-year-over-year",
  "description": "同月同比：比较 2026-03 与 2025-03 的地区销售额，两期均为完整自然月。先汇总再计算差额和同比，其他月份数据排除；基期为 0 时同比为 NULL，缺失期间不补零。",
  "schema": [
    {
      "name": "region",
      "type": "string"
    },
    {
      "name": "orderDate",
      "type": "datetime"
    },
    {
      "name": "sales",
      "type": "number"
    }
  ],
  "dataset": [
    {
      "region": "A",
      "orderDate": "2025-03-28 23:59:59",
      "sales": 100
    },
    {
      "region": "A",
      "orderDate": "2026-03-01 00:00:00",
      "sales": 50
    },
    {
      "region": "A",
      "orderDate": "2026-03-31 23:59:59",
      "sales": 70
    },
    {
      "region": "A",
      "orderDate": "2026-04-01 00:00:00",
      "sales": 999
    },
    {
      "region": "B",
      "orderDate": "2025-03-10 10:00:00",
      "sales": 100
    },
    {
      "region": "B",
      "orderDate": "2026-03-10 10:00:00",
      "sales": 80
    },
    {
      "region": "C",
      "orderDate": "2025-03-10 10:00:00",
      "sales": 0
    },
    {
      "region": "C",
      "orderDate": "2026-03-10 10:00:00",
      "sales": 20
    },
    {
      "region": "D",
      "orderDate": "2026-03-10 10:00:00",
      "sales": 50
    },
    {
      "region": "E",
      "orderDate": "2025-03-10 10:00:00",
      "sales": 60
    },
    {
      "region": "E",
      "orderDate": "2026-03-10 10:00:00",
      "sales": 0
    },
    {
      "region": "F",
      "orderDate": "2025-03-10 10:00:00",
      "sales": 80
    },
    {
      "region": "A",
      "orderDate": "2025-04-01 00:00:00",
      "sales": 888
    }
  ],
  "vquery": {
    "from": {
      "from": {
        "select": [
          "region",
          {
            "field": "orderDate",
            "alias": "month",
            "aggr": {
              "func": "to_month"
            }
          },
          "sales"
        ]
      },
      "select": [
        "region",
        {
          "field": "sales",
          "alias": "currentSales",
          "aggr": {
            "func": "sum"
          },
          "when": {
            "op": "and",
            "conditions": [
              {
                "field": "month",
                "op": "=",
                "value": "2026-03"
              }
            ]
          }
        },
        {
          "field": "sales",
          "alias": "baselineSales",
          "aggr": {
            "func": "sum"
          },
          "when": {
            "op": "and",
            "conditions": [
              {
                "field": "month",
                "op": "=",
                "value": "2025-03"
              }
            ]
          }
        }
      ],
      "where": {
        "op": "and",
        "conditions": [
          {
            "field": "month",
            "op": "in",
            "value": ["2025-03", "2026-03"]
          }
        ]
      },
      "groupBy": ["region"]
    },
    "select": [
      "region",
      "currentSales",
      "baselineSales",
      {
        "expr": "currentSales-baselineSales",
        "alias": "delta"
      },
      {
        "expr": "(currentSales-baselineSales)/NULLIF(baselineSales,0)",
        "alias": "growthRate"
      }
    ],
    "orderBy": [
      {
        "field": "region",
        "order": "asc"
      }
    ]
  }
}
