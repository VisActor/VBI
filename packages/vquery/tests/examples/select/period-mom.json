{
  "datasetId": "select-period-mom",
  "description": "Select with Period MoM (Month-over-Month)",
  "vquery": {
    "select": [
      {
        "field": "order_date",
        "alias": "month",
        "aggr": { "func": "to_month" }
      },
      {
        "field": "sales",
        "alias": "current",
        "aggr": { "func": "sum" }
      },
      {
        "field": "sales",
        "alias": "last_month",
        "aggr": { "func": "sum" },
        "period": {
          "dateField": "order_date",
          "offsetUnit": "month",
          "offset": -1
        }
      }
    ]
  },
  "dataset": [
    { "id": 1, "name": "Alice", "order_date": "2024-01-15", "sales": 5000 },
    { "id": 2, "name": "Bob", "order_date": "2024-02-20", "sales": 8000 },
    { "id": 3, "name": "Charlie", "order_date": "2024-01-10", "sales": 4000 },
    { "id": 4, "name": "David", "order_date": "2023-12-15", "sales": 6000 }
  ],
  "schema": [
    { "name": "id", "type": "number" },
    { "name": "name", "type": "string" },
    { "name": "order_date", "type": "string" },
    { "name": "sales", "type": "number" }
  ]
}
