{
  "datasetId": "select-period-month-over-month",
  "description": "Select with Month-over-Month (MoM) period - calculate sales by department comparing current month vs last month",
  "vquery": {
    "select": [
      {
        "field": "department",
        "alias": "部门"
      },
      {
        "field": "sales",
        "aggr": { "func": "sum" },
        "alias": "当月销售额",
        "period": {
          "offset": 0,
          "offsetUnit": "month",
          "dateField": "date",
          "referenceYear": 2024
        }
      },
      {
        "field": "sales",
        "aggr": { "func": "sum" },
        "alias": "上月销售额",
        "period": {
          "offset": -1,
          "offsetUnit": "month",
          "dateField": "date",
          "referenceYear": 2024
        }
      }
    ],
    "groupBy": ["department"]
  },
  "dataset": [
