{
  "datasetId": "select-period-avg",
  "description": "Select with period using avg aggregation - calculate average sales MoM",
  "vquery": {
    "select": [
      "department",
      {
        "field": "date",
        "aggr": { "func": "to_month" },
        "alias": "month"
      },
      {
        "field": "sales",
        "aggr": { "func": "avg" },
        "alias": "avg_sales",
        "period": {
          "offset": 1,
          "offsetUnit": "month",
          "dateField": "date"
        }
      }
    ],
    "groupBy": ["department", "date"],
    "orderBy": [
      { "field": "department", "order": "asc" },
      { "field": "date", "order": "asc" }
    ]
  },
  "dataset": [
    { "id": 1, "name": "Alice", "department": "HR", "date": "2024-01-15", "sales": 5000 },
    { "id": 2, "name": "Bob", "department": "HR", "date": "2024-02-15", "sales": 6000 },
    { "id": 3, "name": "Charlie", "department": "Engineering", "date": "2024-01-20", "sales": 8000 },
    { "id": 4, "name": "David", "department": "Engineering", "date": "2024-02-20", "sales": 9000 }
  ],
  "schema": [
    { "name": "id", "type": "number" },
    { "name": "name", "type": "string" },
    { "name": "department", "type": "string" },
    { "name": "date", "type": "string" },
    { "name": "sales", "type": "number" }
  ]
}
