{
  "datasetId": "select-period-aggregation",
  "description": "Select with period + different aggregation functions (avg, count, min, max, count_distinct)",
  "vquery": {
    "select": [
      {
        "field": "department",
        "alias": "部门"
      },
      {
        "field": "sales",
        "aggr": { "func": "avg" },
        "alias": "平均销售额",
        "period": {
          "offset": 0,
          "offsetUnit": "year",
          "dateField": "date",
          "referenceYear": 2024
        }
      },
      {
        "field": "sales",
        "aggr": { "func": "count" },
        "alias": "销售记录数",
        "period": {
          "offset": 0,
          "offsetUnit": "year",
          "dateField": "date",
          "referenceYear": 2024
        }
      },
      {
        "field": "sales",
        "aggr": { "func": "min" },
        "alias": "最低销售额",
        "period": {
          "offset": 0,
          "offsetUnit": "year",
          "dateField": "date",
          "referenceYear": 2024
        }
      },
      {
        "field": "sales",
        "aggr": { "func": "max" },
        "alias": "最高销售额",
        "period": {
          "offset": 0,
          "offsetUnit": "year",
          "dateField": "date",
          "referenceYear": 2024
        }
      },
      {
        "field": "name",
        "aggr": { "func": "count_distinct" },
        "alias": "销售人员数",
        "period": {
          "offset": 0,
          "offsetUnit": "year",
          "dateField": "date",
          "referenceYear": 2024
        }
      }
    ],
    "groupBy": ["department"]
  },
  "dataset": [
    { "id": 1, "name": "Alice", "department": "HR", "date": "2024-01-15", "sales": 5000 },
    { "id": 2, "name": "Bob", "department": "HR", "date": "2024-02-20", "sales": 7000 },
    { "id": 3, "name": "Charlie", "department": "HR", "date": "2024-03-10", "sales": 6000 },
    { "id": 4, "name": "David", "department": "Engineering", "date": "2024-01-10", "sales": 12000 },
    { "id": 5, "name": "Eve", "department": "Engineering", "date": "2024-02-15", "sales": 13500 },
    { "id": 6, "name": "Frank", "department": "Engineering", "date": "2024-03-22", "sales": 11000 },
    { "id": 7, "name": "Grace", "department": "Sales", "date": "2024-01-08", "sales": 9000 },
    { "id": 8, "name": "Henry", "department": "Sales", "date": "2024-02-14", "sales": 10500 },
    { "id": 9, "name": "Ivy", "department": "Sales", "date": "2024-03-21", "sales": 8500 }
  ],
  "schema": [
    { "name": "id", "type": "number" },
    { "name": "name", "type": "string" },
    { "name": "department", "type": "string" },
    { "name": "date", "type": "string" },
    { "name": "sales", "type": "number" }
  ]
}
