{
  "datasetId": "select-period-year-over-year",
  "description": "Select with Year-over-Year (YoY) period - calculate sales by department comparing 2024 vs 2023",
  "vquery": {
    "select": [
      {
        "field": "department",
        "alias": "部门"
      },
      {
        "field": "sales",
        "aggr": { "func": "sum" },
        "alias": "2024年销售额",
        "period": {
          "offset": 0,
          "offsetUnit": "year",
          "dateField": "date"
        }
      },
      {
        "field": "sales",
        "aggr": { "func": "sum" },
        "alias": "2023年销售额",
        "period": {
          "offset": -1,
          "offsetUnit": "year",
          "dateField": "date"
        }
      }
    ],
    "groupBy": ["department"]
  },
