{
  "name": "散点图：无数据点的目标区域",
  "description": "目标矩形内没有数据点也可绘制。axisMax 指当前最终坐标轴上限，此处手动设置为 100%；它不是数据最大值 60%。TypeScript 可从 @visactor/vseed 导入 AxisBoundaryEnum.Min / Max，JSON 使用 axisMin / axisMax。",
  "vseed": {
    "chartType": "scatter",
    "dataset": [
      { "channel": "A", "cost": 10, "conversion": 0.1 },
      { "channel": "B", "cost": 60, "conversion": 0.3 },
      { "channel": "C", "cost": 130, "conversion": 0.6 }
    ],
    "dimensions": [{ "id": "channel", "encoding": "color" }],
    "measures": [
      { "id": "cost", "encoding": "xAxis" },
      { "id": "conversion", "encoding": "yAxis" }
    ],
    "yAxis": { "min": 0, "max": 1, "autoFormat": false, "numFormat": { "type": "percent" } },
    "annotationArea": {
      "range": { "x": { "min": 0, "max": 100 }, "y": { "min": 0.7, "max": "axisMax" } },
      "text": "待达成目标",
      "areaColor": "#22c55e",
      "areaColorOpacity": 0.12
    }
  }
}
