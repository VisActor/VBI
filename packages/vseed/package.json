{
  "name": "@visactor/vseed",
  "version": "0.5.7",
  "license": "MIT",
  "homepage": "https://visactor.github.io/VBI",
  "bugs": "https://github.com/VisActor/VBI/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/VisActor/VBI",
    "directory": "packages/vseed"
  },
  "author": {
    "name": "VisActor",
    "url": "https://www.visactor.io/"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "browser": "./dist/umd/index.js",
  "unpkg": "./dist/umd/index.js",
  "jsdelivr": "./dist/umd/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist"
  ],
  "unpkgFiles": [
    "dist/umd/index.js"
  ],
  "scripts": {
    "dev": "rslib build --watch --no-clean",
    "build": "rslib build",
    "dev:rsdoctor": "RSDOCTOR=true rslib dev",
    "build:rsdoctor": "RSDOCTOR=true rslib build",
    "build:docs": "node ./scripts/build-docs.mjs",
    "build:examples": "node ./scripts/build-examples.mjs",
    "build:api": "node ./scripts/build-api.mjs",
    "build:test": "node ./scripts/build-tests.mjs",
    "g": "pnpm run build:test && pnpm run build:docs && pnpm run build:examples && pnpm run build:api",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:update": "vitest run --update",
    "test:coverage": "vitest run --coverage && node scripts/build-coverage-badge.mjs",
    "test:unit": "vitest run tests/unit",
    "test:unit:coverage": "vitest run tests/unit --mode unit --coverage",
    "test:integration": "vitest run --exclude tests/unit",
    "test:integration:update": "vitest run --exclude tests/unit --update",
    "test:integration:coverage": "vitest run --exclude tests/unit --mode integration --coverage"
  },
  "dependencies": {
    "@visactor/vdataset": "~1.0.21",
    "@visactor/vutils": "~1.0.21",
    "remeda": "2.28.0",
    "tinycolor2": "1.4.2",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@rsdoctor/rspack-plugin": "1.2.3",
    "@rslib/core": "1.0.1",
    "@rstest/core": "0.12.0",
    "@rstest/coverage-istanbul": "0.12.0",
    "@types/node": "24.10.1",
    "@types/tinycolor2": "1.4.3",
    "@visactor/vchart": "2.0.23-alpha.6",
    "@visactor/vtable": "1.23.1",
    "@vitest/coverage-istanbul": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "jsdom": "26.1.0",
    "rstest-canvas-mock": "0.0.5",
    "typescript": "7.0.2",
    "vi-canvas-mock": "^1.0.0",
    "ts-morph": "26.0.0",
    "vitest": "3.2.4",
    "@swc/helpers": "0.5.23"
  },
  "sideEffects": false
}
