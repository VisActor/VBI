{
  "name": "@visactor/vbi-agent",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./resource-tools": {
      "source": "./src/tools/resource-tools.ts",
      "types": "./dist/tools/resource-tools.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "test": "rstest",
    "test:update": "rstest --update",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:coverage": "rstest run --coverage"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.75.5",
    "@visactor/vbi": "workspace:*",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@rstest/core": "0.12.0",
    "@rslib/core": "1.0.1",
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "@rstest/coverage-istanbul": "0.12.0"
  }
}
