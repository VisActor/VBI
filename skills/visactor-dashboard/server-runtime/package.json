{
  "name": "vbi-dashboard-runtime",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test *.test.mjs",
    "test:unit:coverage": "node --experimental-test-coverage --test-coverage-include='**/server-runtime/*.mjs' --test-coverage-exclude='**/*.test.mjs' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test database.test.mjs server.test.mjs source.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='**/server-runtime/*.mjs' --test-coverage-exclude='**/*.test.mjs' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test *.test.mjs"
  },
  "dependencies": {
    "@visactor/vquery": "0.7.4",
    "mysql2": "3.15.3"
  }
}
