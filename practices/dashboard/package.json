{
  "name": "dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "test": "rstest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@visactor/vbi": "workspace:*",
    "@visactor/vseed": "workspace:*",
    "antd": "6.1.3",
    "standard": "workspace:*"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "1.4.2",
    "@rslib/core": "0.20.3",
    "@rstest/core": "0.8.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "26.1.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "6.0.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
